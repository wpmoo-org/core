{
  "name": "@wpmoo/core-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "auth:proof": "pnpm --filter @wpmoo/auth test",
    "db:test:migrate": "node packages/db/scripts/assert-no-generated-migrations.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
    "eslint": "10.4.1",
    "eslint-plugin-boundaries": "6.0.2",
    "tsx": "4.22.4",
    "turbo": "2.9.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8"
  }
}
