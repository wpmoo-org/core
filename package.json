{
  "name": "@wpmoo/core-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @wpmoo/playground dev",
    "architecture:check": "node scripts/check-architecture-contracts.mjs",
    "domain:check": "node scripts/check-domain-neutrality.mjs",
    "i18n:check": "pnpm --filter @wpmoo/i18n routes:check",
    "i18n:routes": "pnpm --filter @wpmoo/i18n routes:sync",
    "lint": "eslint . --max-warnings=0 && pnpm domain:check",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "ui:smoke": "node apps/playground/scripts/admin-users-smoke.mjs",
    "auth:proof": "pnpm --filter @wpmoo/auth test",
    "db:generate": "pnpm --filter @wpmoo/db db:generate",
    "db:migrate": "pnpm --filter @wpmoo/db db:migrate",
    "db:seed": "pnpm --filter @wpmoo/db db:seed",
    "db:test:reset": "pnpm --filter @wpmoo/db db:test:reset",
    "db:test:migrate": "pnpm --filter @wpmoo/db db:test:migrate",
    "i18n:sync": "pnpm --filter @wpmoo/i18n routes:sync"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.51.1",
    "@types/node": "25.9.1",
    "eslint": "10.4.1",
    "eslint-plugin-boundaries": "6.0.2",
    "tsx": "4.22.4",
    "turbo": "2.9.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8"
  }
}
