{
  "name": "@wpmoo/db",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema/auth": "./src/schema/auth.ts",
    "./schema/core": "./src/schema/core.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:seed": "tsx src/seed.ts",
    "db:test:reset": "tsx src/reset-test-db.ts",
    "db:test:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/db/test"
  },
  "dependencies": {
    "@wpmoo/rbac": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.21.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10"
  }
}
